{
  "name": "video-cli",
  "version": "0.1.0",
  "description": "终端视频工具箱, 基于 Ink 构建的交互式 CLI 工具",
  "keywords": [
    "cli",
    "ffmpeg",
    "h265",
    "hevc",
    "ink",
    "vaapi",
    "video"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhixiangyao/video-cli"
  },
  "bin": "dist/cli.mjs",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "tsx src/cli.tsx",
    "preview": "node dist/cli.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "ink": "7.1.1",
    "meow": "14.1.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "react": "19.2.8",
    "react-devtools-core": "7.0.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=26.7.0",
    "pnpm": ">=12.0.0-rc.3"
  },
  "packageManager": "pnpm@12.0.0-rc.3"
}
